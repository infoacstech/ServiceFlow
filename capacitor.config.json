{
  "appId": "com.uniquesolutions.serviflow",
  "appName": "ServiFlow",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://serviceflow-969f5.web.app",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0f172a",
      "showSpinner": false
    }
  }
}
