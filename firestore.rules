rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@serviflow.io' ||
        request.auth.token.email == 'superadmin@serviflow.io' ||
        request.auth.uid == 'usr-admin'
      );
    }

    function isUserSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTenantMember(businessId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/tenantMembers/$(businessId + '_' + request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == businessId
        )
      );
    }

    function isTenantOwner(businessId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == businessId &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'business_owner' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
          )
        )
      );
    }

    // Businesses and Tenants collections (Modifications restricted to Business Owner / Super Admin)
    match /businesses/{businessId} {
      allow read: if isAuthenticated() || true; // Public read for tenant profile loading & discovery
      allow create: if isAuthenticated() || true; // Self-registration allowed
      allow update, delete: if isTenantOwner(businessId) || isSuperAdmin();
    }

    match /tenants/{tenantId} {
      allow read: if isAuthenticated() || true;
      allow create: if isAuthenticated() || true;
      allow update, delete: if isTenantOwner(tenantId) || isSuperAdmin();
    }

    // Tenant Memberships
    match /tenantMembers/{membershipId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
    }

    // Users Collection (Adding/Deleting/Modifying staff restricted to Business Owner & Super Admin)
    match /users/{userId} {
      allow read: if isAuthenticated() || true; // Public read for lookup during login
      allow create: if isAuthenticated() || true; // Tenant creation & owner-created staff
      allow update: if isSuperAdmin() || (
        isUserSelf(userId) && request.resource.data.role == resource.data.role
      ) || (
        isAuthenticated() && resource.data.businessId != null && isTenantOwner(resource.data.businessId)
      );
      allow delete: if isSuperAdmin() || (
        isAuthenticated() && resource.data.businessId != null && isTenantOwner(resource.data.businessId)
      );
    }

    // Operational Collections:
    // - READ: All tenant members
    // - CREATE: All tenant members (Owner, Manager, Staff)
    // - UPDATE / DELETE: Restricted to Business Owner / Super Admin (except job execution status updates)

    match /customers/{docId} {
      allow read: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) || isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
        isTenantMember(request.resource.data.businessId) || isSuperAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        isTenantOwner(resource.data.businessId) || isSuperAdmin()
      );
    }

    match /enquiries/{docId} {
      allow read: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) || isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
        isTenantMember(request.resource.data.businessId) || isSuperAdmin()
      );
      allow update: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) || isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        isTenantOwner(resource.data.businessId) || isSuperAdmin()
      );
    }

    match /jobs/{docId} {
      allow read: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) || isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
        isTenantMember(request.resource.data.businessId) || isSuperAdmin()
      );
      allow update: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) || isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        isTenantOwner(resource.data.businessId) || isSuperAdmin()
      );
    }

    match /invoices/{docId} {
      allow read: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) || isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
        isTenantMember(request.resource.data.businessId) || isSuperAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        isTenantOwner(resource.data.businessId) || isSuperAdmin()
      );
    }

    match /quotations/{docId} {
      allow read: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) || isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
        isTenantMember(request.resource.data.businessId) || isSuperAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        isTenantOwner(resource.data.businessId) || isSuperAdmin()
      );
    }

    match /payments/{docId} {
      allow read: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) || isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
        isTenantMember(request.resource.data.businessId) || isSuperAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        isTenantOwner(resource.data.businessId) || isSuperAdmin()
      );
    }

    match /contracts/{docId} {
      allow read: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) || isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
        isTenantMember(request.resource.data.businessId) || isSuperAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        isTenantOwner(resource.data.businessId) || isSuperAdmin()
      );
    }

    match /expenses/{docId} {
      allow read: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) || isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
        isTenantMember(request.resource.data.businessId) || isSuperAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        isTenantOwner(resource.data.businessId) || isSuperAdmin()
      );
    }

    match /inventory/{docId} {
      allow read: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) || isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
        isTenantMember(request.resource.data.businessId) || isSuperAdmin()
      );
      allow update: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) || isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        isTenantOwner(resource.data.businessId) || isSuperAdmin()
      );
    }

    match /inventoryTransactions/{docId} {
      allow read: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) || isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
        isTenantMember(request.resource.data.businessId) || isSuperAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        isTenantOwner(resource.data.businessId) || isSuperAdmin()
      );
    }

    match /categories/{docId} {
      allow read: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) || isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
        isTenantMember(request.resource.data.businessId) || isSuperAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        isTenantOwner(resource.data.businessId) || isSuperAdmin()
      );
    }

    match /services/{docId} {
      allow read: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) || isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
        isTenantMember(request.resource.data.businessId) || isSuperAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        isTenantOwner(resource.data.businessId) || isSuperAdmin()
      );
    }

    match /notifications/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /activities/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /manualSyncLogs/{docId} {
      allow read, write: if isAuthenticated();
    }

    // System Settings & Support Sessions
    match /supportSessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /securityAuditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }

    // Attendance & GPS Verification Rules
    match /attendance/{docId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantOwner(resource.data.businessId) ||
        (isTenantMember(resource.data.businessId) && resource.data.staffId == request.auth.uid)
      );
      allow create: if isAuthenticated() && (
        isTenantMember(request.resource.data.businessId) || isSuperAdmin()
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantOwner(resource.data.businessId) ||
        (isTenantMember(resource.data.businessId) && resource.data.staffId == request.auth.uid && request.resource.data.staffId == request.auth.uid)
      );
      allow delete: if isAuthenticated() && (
        isTenantOwner(resource.data.businessId) || isSuperAdmin()
      );
    }

    match /attendanceIssues/{docId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantOwner(resource.data.businessId) ||
        (isTenantMember(resource.data.businessId) && resource.data.staffId == request.auth.uid)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (isTenantMember(request.resource.data.businessId) && request.resource.data.staffId == request.auth.uid)
      );
      allow update, delete: if isAuthenticated() && (
        isTenantOwner(resource.data.businessId) || isSuperAdmin()
      );
    }

    match /attendanceLocations/{docId} {
      allow read: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) || isSuperAdmin()
      );
      allow create, update, delete: if isAuthenticated() && (
        isTenantOwner(resource.data.businessId) || isSuperAdmin()
      );
    }

    match /attendanceAuditLogs/{docId} {
      allow read: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) || isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
        isTenantMember(request.resource.data.businessId) || isSuperAdmin()
      );
      allow update, delete: if false; // Immutable attendance audit trail
    }

    // Referral System Collections
    match /referrals/{referralId} {
      allow read, write: if isAuthenticated();
    }

    match /referralPayouts/{payoutId} {
      allow read, write: if isAuthenticated();
    }
  }
}
