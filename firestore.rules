rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@serviflow.io' ||
        request.auth.token.email == 'superadmin@serviflow.io' ||
        request.auth.uid == 'usr-admin'
      );
    }

    function isUserSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTenantMember(businessId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/tenantMembers/$(businessId + '_' + request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == businessId
        )
      );
    }

    // Businesses and Tenants collections
    match /businesses/{businessId} {
      allow read: if isAuthenticated() || true; // Public read for tenant profile loading & discovery
      allow create: if isAuthenticated() || true; // Self-registration allowed
      allow update, delete: if isTenantMember(businessId) || isSuperAdmin();
    }

    match /tenants/{tenantId} {
      allow read: if isAuthenticated() || true;
      allow create: if isAuthenticated() || true;
      allow update, delete: if isTenantMember(tenantId) || isSuperAdmin();
    }

    // Tenant Memberships
    match /tenantMembers/{membershipId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() || true; // Public read for lookup during login
      allow create: if isAuthenticated() || true; // Tenant creation & owner-created staff
      allow update: if isSuperAdmin() || (
        isUserSelf(userId) && request.resource.data.role != 'super_admin' && request.resource.data.businessId != 'all'
      ) || (
        isAuthenticated() && resource.data.businessId != null && isTenantMember(resource.data.businessId) && request.resource.data.role != 'super_admin'
      );
      allow delete: if isSuperAdmin() || (
        isAuthenticated() && resource.data.businessId != null && isTenantMember(resource.data.businessId)
      );
    }

    // Tenant Operational Collections (Protected by Tenant Membership & Super Admin)
    match /enquiries/{docId} {
      allow read, write: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) ||
        isTenantMember(request.resource.data.businessId) ||
        isSuperAdmin()
      );
    }

    match /customers/{docId} {
      allow read, write: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) ||
        isTenantMember(request.resource.data.businessId) ||
        isSuperAdmin()
      );
    }

    match /jobs/{docId} {
      allow read, write: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) ||
        isTenantMember(request.resource.data.businessId) ||
        isSuperAdmin()
      );
    }

    match /invoices/{docId} {
      allow read, write: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) ||
        isTenantMember(request.resource.data.businessId) ||
        isSuperAdmin()
      );
    }

    match /quotations/{docId} {
      allow read, write: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) ||
        isTenantMember(request.resource.data.businessId) ||
        isSuperAdmin()
      );
    }

    match /payments/{docId} {
      allow read, write: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) ||
        isTenantMember(request.resource.data.businessId) ||
        isSuperAdmin()
      );
    }

    match /contracts/{docId} {
      allow read, write: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) ||
        isTenantMember(request.resource.data.businessId) ||
        isSuperAdmin()
      );
    }

    match /expenses/{docId} {
      allow read, write: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) ||
        isTenantMember(request.resource.data.businessId) ||
        isSuperAdmin()
      );
    }

    match /inventory/{docId} {
      allow read, write: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) ||
        isTenantMember(request.resource.data.businessId) ||
        isSuperAdmin()
      );
    }

    match /inventoryTransactions/{docId} {
      allow read, write: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) ||
        isTenantMember(request.resource.data.businessId) ||
        isSuperAdmin()
      );
    }

    match /categories/{docId} {
      allow read, write: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) ||
        isTenantMember(request.resource.data.businessId) ||
        isSuperAdmin()
      );
    }

    match /services/{docId} {
      allow read, write: if isAuthenticated() && (
        isTenantMember(resource.data.businessId) ||
        isTenantMember(request.resource.data.businessId) ||
        isSuperAdmin()
      );
    }

    match /notifications/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /activities/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /manualSyncLogs/{docId} {
      allow read, write: if isAuthenticated();
    }

    // System Settings & Support Sessions
    match /supportSessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /securityAuditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }

    // Referral System Collections
    match /referrals/{referralId} {
      allow read, write: if isAuthenticated();
    }

    match /referralPayouts/{payoutId} {
      allow read, write: if isAuthenticated();
    }

    match /roles/{roleId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}

