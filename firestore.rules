rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Businesses collection - Allow public read and registration create/updates
    match /businesses/{businessId} {
      allow read, write: if true;
    }

    // Users collection - Allow public read for login matching and self-registration
    match /users/{userId} {
      allow read, write: if true;
    }

    // Tenant operational collections
    match /customers/{docId} {
      allow read, write: if true;
    }
    match /categories/{docId} {
      allow read, write: if true;
    }
    match /services/{docId} {
      allow read, write: if true;
    }
    match /jobs/{docId} {
      allow read, write: if true;
    }
    match /inventory/{docId} {
      allow read, write: if true;
    }
    match /inventoryTransactions/{docId} {
      allow read, write: if true;
    }
    match /quotations/{docId} {
      allow read, write: if true;
    }
    match /invoices/{docId} {
      allow read, write: if true;
    }
    match /payments/{docId} {
      allow read, write: if true;
    }
    match /contracts/{docId} {
      allow read, write: if true;
    }
    match /expenses/{docId} {
      allow read, write: if true;
    }
    match /notifications/{docId} {
      allow read, write: if true;
    }
    match /activities/{docId} {
      allow read, write: if true;
    }
    match /manualSyncLogs/{docId} {
      allow read, write: if true;
    }

    // Super Admin System Collections & Security Logs
    match /supportSessions/{sessionId} {
      allow read, write: if true;
    }
    match /systemSettings/{settingId} {
      allow read, write: if true;
    }
    match /securityAuditLogs/{logId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false; // Immutable audit trail
    }
    match /roles/{roleId} {
      allow read, write: if true;
    }
  }
}
